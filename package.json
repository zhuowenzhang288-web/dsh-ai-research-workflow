{
  "name": "dsh-research-agent",
  "version": "1.0.0",
  "description": "DSH Research Agent：搭载于 DeepSeek Harness 的科研 agent——现象驱动工作流 + 科研模式 preset + 科研侦探人格 + 8 个零依赖脚本",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets",
    "research-preset"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}